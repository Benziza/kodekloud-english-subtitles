{
  "manifest_version": 3,
  "name": "KodeKloud Subtitle Companion",
  "version": "2.0.0",
  "description": "Shows available KodeKloud English subtitles live in a separate companion tab.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "KodeKloud Subtitle Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.kodekloud.com/*",
        "https://player.vimeo.com/*"
      ],
      "js": [
        "subtitle-engine.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
